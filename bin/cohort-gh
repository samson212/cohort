#!/bin/bash
# cohort-gh: run gh against the host this repo's remote actually points at.
#
# gh does infer the host from git remotes, but only for hosts it considers
# authenticated (an entry in hosts.yml, or GH_TOKEN). exe.dev injects the
# GitHub credential at the network edge, so nothing on disk tells gh that
# github.int.exe.xyz is usable: the remote gets filtered out, gh falls back
# to github.com, finds no token, and prints "gh auth login".
#
# Setting GH_HOST is the documented fix (exe.dev/docs/integrations-github).
# Deriving it from origin, rather than exporting it globally, keeps repos
# whose remote really is github.com working too.
#
# Usage: cohort-gh <any gh arguments>
set -e

url=$(git remote get-url origin 2>/dev/null) || {
    echo "cohort-gh: no 'origin' remote in $(pwd)" >&2
    exit 1
}

# Strip the parts around the host, then require what's left to look like a
# hostname. Anything else (a local path, a file:// URL, an empty remote) is
# rejected rather than passed to gh as a bogus GH_HOST.
#   https://host/owner/repo  git@host:owner/repo  ssh://git@host:22/owner/repo
host=${url#*://}       # strip scheme, if any
host=${host#*@}        # strip user@, if any
host=${host%%[:/]*}    # keep up to the first : or /

if [[ ! "$host" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]; then
    echo "cohort-gh: origin does not look like a hosted git URL: $url" >&2
    echo "cohort-gh: could not determine a GitHub host to target." >&2
    exit 1
fi

# Guard: an ambient GH_HOST that disagrees with origin is usually a stale
# export from an earlier improvised session. Failing loudly beats
# accidentally hitting the wrong host (or a host the user didn't intend).
if [[ -n "${GH_HOST:-}" && "$GH_HOST" != "$host" ]]; then
    echo "cohort-gh: GH_HOST is set to '$GH_HOST' but origin is '$host'; refusing to guess." >&2
    echo "cohort-gh: unset GH_HOST and retry (cohort-gh derives the host from origin)." >&2
    exit 2
fi

# Cold-start retry. The exe.dev edge proxy idles out, and the first request
# after a quiet period fails while it warms back up; a second attempt a
# second later goes through. Two signatures are treated as transient:
#
#   - HTTP 502/503/504 — what gh reports while the edge is still warming.
#   - "integration not found or not attached to this VM" — the proxy's own
#     cold-start body, which it returns with a 403.
#
# The 403 is matched on that sentence, never on the status: the proxy only
# routes repo-scoped paths, so `/` and `/user` 403 BY DESIGN and permanently
# (docs/cohort-gh.md). Retrying those would burn three seconds to reprint the
# same error. Anything that doesn't match either signature fails on the first
# attempt, as before.
transient_error='HTTP (502|503|504)|integration not found or not attached to this VM'
attempts=3
delay=1

# gh's stdout is data (`cohort-gh pr list`), so it is buffered rather than
# sampled: a retry must not emit the failed attempt's partial output ahead of
# the real one. Both streams are replayed verbatim below, on success and on
# failure alike. The tradeoff: gh sees a non-TTY stdout, so it drops the pager
# and colour, and refuses to prompt — an invocation that relies on interactive
# prompts must pass its arguments as flags instead.
stdout_buf=$(mktemp) || exit 1
stderr_buf=$(mktemp) || exit 1
trap 'rm -f "$stdout_buf" "$stderr_buf"' EXIT

for (( attempt = 1; attempt <= attempts; attempt++ )); do
    status=0
    GH_HOST="$host" gh "$@" >"$stdout_buf" 2>"$stderr_buf" || status=$?

    (( status == 0 )) && break
    (( attempt == attempts )) && break
    # Only the diagnosis stream votes on retrying. Matching gh's stdout too
    # would let a PR body that quotes "HTTP 503" trigger a pointless retry.
    [[ $(< "$stderr_buf") =~ $transient_error ]] || break

    echo "cohort-gh: transient edge failure (cold start); retrying in ${delay}s (attempt $(( attempt + 1 ))/${attempts})" >&2
    sleep "$delay"
    delay=$(( delay * 2 ))
done

# Replay gh's own output and exit status. On a final failure the user sees
# gh's real error, not a summary of it.
cat "$stdout_buf"
cat "$stderr_buf" >&2
exit "$status"
