#!/bin/bash
# cohort-commit: commit staged changes using a message file.
# Called by /git-commit after review/staging/message-draft steps.
# Usage: cohort-commit <message-file>
set -e

msg_file="$1"
if [[ -z "$msg_file" ]]; then
    echo "Usage: cohort-commit <message-file>" >&2
    exit 1
fi

cd "$(git rev-parse --show-toplevel)"
git commit -F "$msg_file"
