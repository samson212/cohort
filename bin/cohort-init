#!/bin/bash
# cohort-init: bootstrap Cohort into a target project.
# Run from the project root. Installs the shelley hook and scaffolds .cohort/.
#
# The Cohort engine lives at ~/.cohort/. This script derives that path
# from its own location, so it works whether ~/.cohort/ is a clone,
# a symlink to a sibling repo, or a subdirectory.
#
# Usage: ~/.cohort/bin/cohort-init [project-name]
#   project-name defaults to the current directory's basename.
set -e

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
ENGINE_ROOT=$(dirname "$SCRIPT_DIR")
PROJECT_ROOT="$PWD"
PROJECT_NAME="${1:-$(basename "$PROJECT_ROOT")}"

if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
    echo "Error: $PROJECT_ROOT is not a git repository. Run this from a project root." >&2
    exit 1
fi

echo "Bootstrapping Cohort for $PROJECT_NAME..."
echo "  Engine: $ENGINE_ROOT"
echo "  Project: $PROJECT_ROOT"

# 1. Scaffold .cohort/ with a template prompt.md
mkdir -p "$PROJECT_ROOT/.cohort/docs"
if [[ ! -f "$PROJECT_ROOT/.cohort/prompt.md" ]]; then
    cat > "$PROJECT_ROOT/.cohort/prompt.md" << 'PROMPTEOF'
# Project context

TODO: describe this project — what it does, its tech stack, key conventions,
and anything Cohort should know when working here. This file is the delta on
top of Cohort's universal docs; keep it project-specific.

The project is called PROJECT_NAME_PLACEHOLDER.
PROMPTEOF
    # Replace the placeholder
    sed -i "s/PROJECT_NAME_PLACEHOLDER/$PROJECT_NAME/" "$PROJECT_ROOT/.cohort/prompt.md"
    echo "  Created .cohort/prompt.md"
else
    echo "  .cohort/prompt.md already exists, skipping"
fi

# 2. Install the shelley hook
mkdir -p ~/.config/shelley/hooks
if [[ -L ~/.config/shelley/hooks/system-prompt ]]; then
    echo "  Hook already installed: ~/.config/shelley/hooks/system-prompt"
else
    ln -sf "$ENGINE_ROOT/hooks/system-prompt" ~/.config/shelley/hooks/system-prompt
    echo "  Installed hook: ~/.config/shelley/hooks/system-prompt -> $ENGINE_ROOT/hooks/system-prompt"
fi

echo ""
echo "Done. Open Shelley in $PROJECT_ROOT to use Cohort."
echo "Next: edit .cohort/prompt.md to describe this project."
