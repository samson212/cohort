#!/bin/bash
# cohort-init: bootstrap Cohort into a target project.
# Run from the project root. Installs the shelley hook and scaffolds .cohort/.
#
# The Cohort engine lives wherever you cloned it (e.g. ~/cohort/).
# A symlink ~/.cohort -> ~/cohort is the recommended convention so
# tooling finds it at a predictable path while keeping the repo visible.
#
# Usage: ~/.cohort/bin/cohort-init [--enforce-git] [project-name]
#   project-name defaults to the repo name (from the origin remote), or the
#   current directory's basename when there's no remote.
#   --enforce-git  creates ~/.cohort/enforce-git to block git commit/push/rebase for agents
set -e

ENFORCE_GIT=false
PROJECT_NAME=""
for arg in "$@"; do
  case "$arg" in
    --enforce-git) ENFORCE_GIT=true ;;
    *) PROJECT_NAME="$arg" ;;
  esac
done

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
ENGINE_ROOT=$(dirname "$SCRIPT_DIR")
PROJECT_ROOT="$PWD"
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: not inside a git repository. Run this from a project root." >&2
    exit 1
fi

if [[ -z "$PROJECT_NAME" ]]; then
    # Default to the repo name from the origin remote, so a worktree or clone
    # whose directory name differs from the repo doesn't get the wrong name
    # stamped into .cohort/prompt.md. Fall back to the directory basename
    # when there's no remote.
    REPO_URL=$(git remote get-url origin 2>/dev/null || true)
    if [[ -n "$REPO_URL" ]]; then
        REPO_NAME=$(basename "$REPO_URL")
        REPO_NAME="${REPO_NAME%.git}"
    fi
    PROJECT_NAME="${REPO_NAME:-$(basename "$PROJECT_ROOT")}"
fi

echo "Bootstrapping Cohort for $PROJECT_NAME..."
echo "  Engine: $ENGINE_ROOT"
echo "  Project: $PROJECT_ROOT"

# 1. Skip scaffolding when in the engine repo itself
ENGINE_REAL=$(readlink -f "$ENGINE_ROOT")
PROJECT_REAL=$(readlink -f "$PROJECT_ROOT")
if [[ "$ENGINE_REAL" == "$PROJECT_REAL" ]]; then
    echo "Skipping .cohort/ scaffold — this is the engine repo."
else
    mkdir -p "$PROJECT_ROOT/.cohort/docs"
    touch "$PROJECT_ROOT/.cohort/docs/.gitkeep"
    if [[ ! -f "$PROJECT_ROOT/.cohort/prompt.md" ]]; then
        cat > "$PROJECT_ROOT/.cohort/prompt.md" << PROMPTEOF
# Project context

TODO: describe this project — what it does, its tech stack, key conventions,
and anything Cohort should know when working here. This file is the delta on
top of Cohort's universal docs; keep it project-specific.

The project is called ${PROJECT_NAME}.
PROMPTEOF
        echo "Created .cohort/prompt.md"
    else
        echo ".cohort/prompt.md already exists, skipping"
    fi
fi

# 2. Install the shelley hook(s)
HOOK_SRC="$ENGINE_ROOT/hooks/system-prompt"
HOOK_DST="$HOME/.config/shelley/hooks/system-prompt"
mkdir -p "$(dirname "$HOOK_DST")"
if [[ -L "$HOOK_DST" ]]; then
    CURRENT_TARGET=$(readlink -f "$HOOK_DST")
    WANTED_TARGET=$(readlink -f "$HOOK_SRC")
    if [[ "$CURRENT_TARGET" == "$WANTED_TARGET" ]]; then
        echo "Hook already installed: $HOOK_DST"
    else
        ln -sf "$HOOK_SRC" "$HOOK_DST"
        echo "Hook relinked: $HOOK_DST -> $HOOK_SRC (was -> $CURRENT_TARGET)"
    fi
else
    ln -sf "$HOOK_SRC" "$HOOK_DST"
    echo "Installed hook: $HOOK_DST -> $HOOK_SRC"
fi

# 3. Install the slash hooks (/cohort-* commands)
SLASH_SRC_DIR="$ENGINE_ROOT/hooks/slash"
SLASH_DST_DIR="$HOME/.config/shelley/hooks/slash"
mkdir -p "$SLASH_DST_DIR"
for hook_src in "$SLASH_SRC_DIR"/cohort-*; do
    [[ -f "$hook_src" ]] || continue
    hook_name=$(basename "$hook_src")
    hook_dst="$SLASH_DST_DIR/$hook_name"
    if [[ -L "$hook_dst" ]]; then
        CURRENT_TARGET=$(readlink -f "$hook_dst")
        WANTED_TARGET=$(readlink -f "$hook_src")
        if [[ "$CURRENT_TARGET" == "$WANTED_TARGET" ]]; then
            echo "Slash hook already installed: $hook_dst"
        else
            ln -sf "$hook_src" "$hook_dst"
            echo "Slash hook relinked: $hook_dst -> $hook_src (was -> $CURRENT_TARGET)"
        fi
    else
        ln -sf "$hook_src" "$hook_dst"
        echo "Installed slash hook: $hook_dst -> $hook_src"
    fi
done

# Remove any stale slash hooks for commands that no longer exist (e.g. the
# old /cohort-close name) so a renamed command doesn't linger.
for hook_dst in "$SLASH_DST_DIR"/cohort-*; do
    [[ -L "$hook_dst" ]] || continue
    hook_src="$SLASH_SRC_DIR/$(basename "$hook_dst")"
    if [[ ! -e "$hook_src" ]]; then
        rm "$hook_dst"
        echo "Removed stale slash hook: $hook_dst"
    fi
done

# 4. Git enforcement (opt-in)
if $ENFORCE_GIT; then
  ENFORCE_MARKER="$HOME/.cohort/enforce-git"
  if [[ -f "$ENFORCE_MARKER" ]]; then
    echo "Git enforcement already enabled: $ENFORCE_MARKER"
  else
    touch "$ENFORCE_MARKER"
    echo "Git enforcement enabled: agents cannot git commit/push/rebase."
    echo "  Remove $ENFORCE_MARKER to disable."
  fi
fi

echo ""
echo "Done. Open Shelley in $PROJECT_ROOT to use Cohort."
if [[ "$ENGINE_REAL" != "$PROJECT_REAL" ]]; then
    echo "Next: edit .cohort/prompt.md to describe this project."
fi
