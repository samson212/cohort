#!/bin/bash
# cohort-init: bootstrap Cohort into a target project.
# Run from the project root. Installs the shelley hook and scaffolds .cohort/.
#
# The Cohort engine lives wherever you cloned it (e.g. ~/cohort/).
# A symlink ~/.cohort -> ~/cohort is the recommended convention so
# tooling finds it at a predictable path while keeping the repo visible.
#
# Usage: ~/.cohort/bin/cohort-init [project-name]
#          [--dashboard-port PORT]
#   project-name defaults to the current directory's basename.
#   --dashboard-port   port for `cohort-dashboard` (default: 6283)
set -e

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
ENGINE_ROOT=$(dirname "$SCRIPT_DIR")
PROJECT_ROOT="$PWD"
DASHBOARD_PORT=6283
PROJECT_NAME=""

# Parse args
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dashboard-port)
            DASHBOARD_PORT="$2"; shift 2 ;;
        *)
            if [[ -z "$PROJECT_NAME" ]]; then
                PROJECT_NAME="$1"
            fi
            shift ;;
    esac
done
PROJECT_NAME="${PROJECT_NAME:-$(basename "$PROJECT_ROOT")}"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: not inside a git repository. Run this from a project root." >&2
    exit 1
fi

echo "Bootstrapping Cohort for $PROJECT_NAME..."
echo "  Engine: $ENGINE_ROOT"
echo "  Project: $PROJECT_ROOT"

# 1. Write dashboard config (~/.config/cohort-dashboard/config).
#    Only the port is used — the dashboard serves relative paths that
#    resolve against whatever origin the browser loaded the page from,
#    so a domain is never written here (see dashboard-design.md).
CONFIG_DIR="$HOME/.config/cohort-dashboard"
mkdir -p "$CONFIG_DIR"
cat > "$CONFIG_DIR/config" <<CONFEOF
{
  "port": $DASHBOARD_PORT
}
CONFEOF
echo "Dashboard config: $CONFIG_DIR/config"
echo "  port  : $DASHBOARD_PORT"

# 2. Skip scaffolding when in the engine repo itself
ENGINE_REAL=$(readlink -f "$ENGINE_ROOT")
PROJECT_REAL=$(readlink -f "$PROJECT_ROOT")
if [[ "$ENGINE_REAL" == "$PROJECT_REAL" ]]; then
    echo "Skipping .cohort/ scaffold — this is the engine repo."
else
    mkdir -p "$PROJECT_ROOT/.cohort/docs"
    touch "$PROJECT_ROOT/.cohort/docs/.gitkeep"
    if [[ ! -f "$PROJECT_ROOT/.cohort/prompt.md" ]]; then
        cat > "$PROJECT_ROOT/.cohort/prompt.md" << PROMPTEOF
# Project context

TODO: describe this project — what it does, its tech stack, key conventions,
and anything Cohort should know when working here. This file is the delta on
top of Cohort's universal docs; keep it project-specific.

The project is called ${PROJECT_NAME}.
PROMPTEOF
        echo "Created .cohort/prompt.md"
    else
        echo ".cohort/prompt.md already exists, skipping"
    fi
fi

# 3. Install the shelley hook(s)
HOOK_SRC="$ENGINE_ROOT/hooks/system-prompt"
HOOK_DST="$HOME/.config/shelley/hooks/system-prompt"
mkdir -p "$(dirname "$HOOK_DST")"
if [[ -L "$HOOK_DST" ]]; then
    CURRENT_TARGET=$(readlink -f "$HOOK_DST")
    WANTED_TARGET=$(readlink -f "$HOOK_SRC")
    if [[ "$CURRENT_TARGET" == "$WANTED_TARGET" ]]; then
        echo "Hook already installed: $HOOK_DST"
    else
        ln -sf "$HOOK_SRC" "$HOOK_DST"
        echo "Hook relinked: $HOOK_DST -> $HOOK_SRC (was -> $CURRENT_TARGET)"
    fi
else
    ln -sf "$HOOK_SRC" "$HOOK_DST"
    echo "Installed hook: $HOOK_DST -> $HOOK_SRC"
fi

# 3. Install the slash hook(s): one dispatcher symlinked per skill name.
SLASH_SRC_DIR="$ENGINE_ROOT/hooks/slash"
SLASH_DST_DIR="$HOME/.config/shelley/hooks/slash"
SKILLS_DIR="$ENGINE_ROOT/skills"
mkdir -p "$SLASH_DST_DIR"

DISPATCHER="$SLASH_SRC_DIR/cohort"
if [[ ! -f "$DISPATCHER" ]]; then
    echo "Error: slash dispatcher hook not found at $DISPATCHER" >&2
    exit 1
fi

# Symlink the dispatcher once per skill in the registry
# (skills/cohort-<name>/SKILL.md). The registry is the source of truth —
# adding a skill dir makes /cohort-<name> work; removing one drops it.
installed_any=0
for skill_dir in "$SKILLS_DIR"/cohort-*/; do
    [[ -d "$skill_dir" ]] || continue
    skill_name=$(basename "$skill_dir")
    [[ "$skill_name" == cohort-* ]] || continue
    [[ -f "$skill_dir/SKILL.md" ]] || continue
    hook_dst="$SLASH_DST_DIR/$skill_name"
    if [[ -L "$hook_dst" ]]; then
        CURRENT_TARGET=$(readlink -f "$hook_dst")
        if [[ "$CURRENT_TARGET" == "$(readlink -f "$DISPATCHER")" ]]; then
            echo "Slash hook already installed: $hook_dst"
        else
            ln -sf "$DISPATCHER" "$hook_dst"
            echo "Slash hook relinked: $hook_dst -> $DISPATCHER (was -> $CURRENT_TARGET)"
        fi
    else
        ln -sf "$DISPATCHER" "$hook_dst"
        echo "Installed slash hook: $hook_dst -> $DISPATCHER"
    fi
    installed_any=1
done

if [[ "$installed_any" == "0" ]]; then
    echo "Warning: no skills found in $SKILLS_DIR (no slash hooks installed)" >&2
fi

# Remove stale slash hooks: any cohort-* hook in the destination that does
# not correspond to a skill dir in the registry (or that points at engine
# files that no longer exist) is removed.
for hook_dst in "$SLASH_DST_DIR"/cohort-*; do
    [[ -L "$hook_dst" ]] || continue
    skill_name=$(basename "$hook_dst")
    if [[ ! -d "$SKILLS_DIR/$skill_name" ]]; then
        rm "$hook_dst"
        echo "Removed stale slash hook: $hook_dst"
    fi
done

echo ""
echo "Done. Open Shelley in $PROJECT_ROOT to use Cohort."
if [[ "$ENGINE_REAL" != "$PROJECT_REAL" ]]; then
    echo "Next: edit .cohort/prompt.md to describe this project."
fi
