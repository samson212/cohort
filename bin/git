#!/bin/bash
# git wrapper — transparent pass-through until enforcement is opted in.
# `cohort-init --enforce-git` creates ~/.cohort/enforce-git AND obscures the
# real git as /usr/bin/git.do.not.call, leaving this wrapper as the only git
# on PATH. The renamed name is a deliberate proscription: a model exploring
# the filesystem sees git.do.not.call and knows not to call it.
#
# Resolves the real git: prefers /usr/bin/git.do.not.call (the obscured
# binary), falls back to well-known paths, excluding this wrapper itself
# (self-shadow guard).

SELF=$(readlink -f "$0")

REAL_GIT=/usr/bin/git.do.not.call
if [[ ! -x "$REAL_GIT" ]]; then
  REAL_GIT=""
  for candidate in /usr/bin/git /bin/git; do
    if [[ -x "$candidate" && "$(readlink -f "$candidate")" != "$SELF" ]]; then
      REAL_GIT="$candidate"
      break
    fi
  done
  if [[ -z "$REAL_GIT" ]]; then
    REAL_GIT=$(command -v git 2>/dev/null || true)
    if [[ -n "$REAL_GIT" && "$(readlink -f "$REAL_GIT")" == "$SELF" ]]; then
      REAL_GIT=""
    fi
  fi
fi

if [[ -z "$REAL_GIT" ]]; then
  echo "ERROR: cannot locate the real git binary (wrapper at $SELF)." >&2
  exit 1
fi

ENFORCE_FILE="$HOME/.cohort/enforce-git"

if [[ -f "$ENFORCE_FILE" ]]; then
  # Walk all args for the blocked subcommand — flags like -C, -c, --git-dir
  # can appear before it, so $1 alone is not enough.
  skip_next=false
  for arg in "$@"; do
    if $skip_next; then
      skip_next=false
      continue
    fi
    case "$arg" in
      -C|-c) skip_next=true ;;
      -*)     ;;  # skip other flags
      commit|push|rebase)
        if [[ ! -t 0 ]]; then
          case "$arg" in
            commit) echo "BLOCKED: git commit is forbidden for agents. Use /cohort-commit instead." >&2 ;;
            push)   echo "BLOCKED: git push is forbidden for agents. Use /cohort-push instead." >&2 ;;
            rebase) echo "BLOCKED: git rebase is forbidden. Amend local-only commits, revert pushed commits. Never rebase pushed history." >&2 ;;
          esac
          exit 1
        fi
        exec "$REAL_GIT" "$@"
        ;;
    esac
  done
fi

exec "$REAL_GIT" "$@"
