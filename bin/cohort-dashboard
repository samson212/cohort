<body>
<header>
  <h1>◧ cohort dashboard</h1>
  <span class="sub">worktrees &amp; pull requests</span>
  <div class="spacer"></div>
  <div class="meta">
    <span id="updated"><span class="dot"></span>loading…</span>
    <span id="repocount"></span>
  </div>
