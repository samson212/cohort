  .meta { color: var(--muted); font-size: 12px; display: flex; gap: 14px; align-items: center; }
  .meta .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); display: inline-block; margin-right: 5px; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 22px 28px 60px; }
