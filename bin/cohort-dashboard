<div class="wrap">
  <div id="repo-views"></div>
  <footer>Auto-refreshes every 30s · data collected from local git + <code>gh</code> · cohort engine</footer>
</div>
<script>
const fmt = {
  age(d) {
    if (d == null) return '—';
    if (d < 1) return Math.round(d * 24) + 'h';
    if (d < 30) return d + 'd';
    return Math.round(d / 30) + 'mo';
  },
  time(iso) {
    if (!iso) return '';
    const dt = new Date(iso);
    return dt.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  },
  esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
};

// GitHub web links — repo.web is the canonical public URL, resolved by gh
// (repo view url) and falling back to the origin-derived base when gh is off.
// Paths are URL-encoded so branch names like "feature/foo" stay valid.
function treeUrl(repo, branch) { return repo.web ? `${repo.web}/tree/${encodeURIComponent(branch)}` : ''; }
function commitUrl(repo, sha)   { return repo.web ? `${repo.web}/commit/${encodeURIComponent(sha)}` : ''; }
function compareUrl(repo, base, head) {
  return repo.web ? `${repo.web}/compare/${encodeURIComponent(base)}...${encodeURIComponent(head)}` : '';
}

// Open PRs are all live by definition; order them by how recently they
// moved (updatedAt, else createdAt), drafts after ready ones.
function prCmp(a, b) {
  if ((a.isDraft ? 1 : 0) !== (b.isDraft ? 1 : 0)) return a.isDraft ? 1 : -1;
  const ta = Date.parse(a.updatedAt) || Date.parse(a.createdAt) || 0;
  const tb = Date.parse(b.updatedAt) || Date.parse(b.createdAt) || 0;
  return tb - ta;
}

// gh returns PR URLs on the canonical github.com host even when we're on an
// int mirror; the page only reaches the right UI if the host matches the
// repo's origin, so re-home any URL that has a different host.
function prUrl(repo, raw) {
  if (!raw || !repo.web) return '';
  try {
    const u = new URL(raw);
    const w = new URL(repo.web);
    if (u.host !== w.host) u.host = w.host;
    return u.toString();
  } catch { return raw; }
}

function branchCell(repo, name, opts = {}) {
  const onRemote = opts.onRemote !== false;  // default: assume it exists
  const url = onRemote ? (opts.url || treeUrl(repo, name)) : '';
  const inner = fmt.esc(name);
  const suffix = opts.suffix ? ` ${opts.suffix}` : '';
  const sub = opts.sub ? `<div class="subj">${opts.sub}</div>` : '';
  if (url) {
    return `<td class="branch"><a href="${url}" target="_blank" rel="noopener">${inner}</a>${suffix}${sub}</td>`;
  }
  // Not on the remote: nothing to link to. Deleted branches (were on the
  // remote, no longer are) render grey so the operator can see they once
  // existed; local-only branches just render plain — no link, no
  // decoration.
  if (opts.deleted) {
    return `<td class="branch dead">${inner}${suffix}${sub}</td>`;
  }
  return `<td class="branch">${inner}${suffix}${sub}</td>`;
}

function statusBadge(wt, repo) {
  const map = {
    dirty:    ['red',   'dirty'],
    unpushed: ['yellow','unpushed'],
    deleted:  ['gray',   'deleted'],
    'up to date': ['green', 'up to date'],
    local:    ['purple', 'local'],
  };
  const [cls, txt] = map[wt.status] || ['gray', wt.status];
  // Make the pill itself link to the GitHub page that explains it:
  //   dirty/unpushed → compare default...branch (what's ahead)
  //   up to date → the tree (nothing to compare)
  //   local (never pushed) → no page exists; no link
  //   deleted → no tree page (branch is gone); PR links if present
  let href = '';
  if (repo && repo.web && wt.on_remote !== false) {
    if (wt.pr_number) href = prUrl(repo, wt.pr_url);
    else if (wt.status === 'unpushed' || wt.status === 'dirty')
      href = compareUrl(repo, repo.default_branch, wt.branch);
    else href = treeUrl(repo, wt.branch);
  } else if (wt.deleted && repo && repo.web && wt.pr_number) {
    href = prUrl(repo, wt.pr_url);
  }
  const span = `<span class="badge ${cls}">${txt}</span>`;
  return href ? `<a href="${href}" target="_blank" rel="noopener">${span}</a>` : span;
}

function prBadge(wt, repo) {
  if (!wt.pr_number) return '<span class="pill gray">no PR</span>';
  const st = wt.pr_state === 'OPEN' ? 'green' : 'gray';
  const draft = wt.pr_draft ? ' ✎' : '';
  const href = prUrl(repo, wt.pr_url) || fmt.esc(wt.pr_url || '#');
  return `<a class="prlink" href="${href}" target="_blank" rel="noopener">
    <span class="badge ${st}">#${wt.pr_number}${draft}</span></a>`;
}

function prRow(pr, repo) {
  const head = pr.headRefName || '';
  const headCell = repo ? branchCell(repo, head) : `<td class="branch">${fmt.esc(head)}</td>`;
  const href = prUrl(repo, pr.url) || fmt.esc(pr.url || '#');
  return `<tr>${headCell}
    <td><span class="badge green">#${pr.number} OPEN</span></td>
    <td><a href="${href}" target="_blank" rel="noopener">${fmt.esc(pr.title)}</a>
      ${pr.isDraft ? '<span class="draft-dot" title="draft"></span>' : ''}</td>
    <td>+${pr.additions ?? 0}/−${pr.deletions ?? 0}</td>
    <td>${fmt.esc(pr.mergeable || '')}</td>
    <td>${fmt.time(pr.createdAt)}</td></tr>`;
}

function render(data) {
  const updated = document.getElementById('updated');
  updated.innerHTML = `<span class="dot"></span>updated ${fmt.time(data.collected_at || data.generated_at)}`;

  const views = (data.repos || []).map(repo => {
    // The server (sort_groups) has already ordered every group — active PRs
    // first, merged/deleted at the tail. Rows are rendered in payload order.
    const wts = repo.worktrees || [];
    const orphans = (repo.orphans || [])
      .filter(o => o.status === 'merged' || o.status === 'orphan');
    const open = repo.open_prs || [];
    const remoteOnly = repo.remote_only || [];
    const rows = wts.map(wt => `
      <tr>
        ${branchCell(repo, wt.branch, {
          onRemote: wt.on_remote,
          deleted: !!wt.deleted,
          sub: wt.subject && !wt.is_primary ? fmt.esc(wt.subject) : '',
          suffix: wt.is_primary ? '<span class="pill" title="primary checkout">main</span>' : ''
        })}
        <td>${statusBadge(wt, repo)}</td>
        <td>${wt.dirty_files ? `${wt.staged}+${wt.unstaged}/~${wt.untracked} <span class="pill">${wt.dirty_files} files</span>` : '<span class="pill gray">clean</span>'}</td>
        <td>${wt.behind ? `<span class="err">▼${wt.behind}</span>` : ''}${wt.ahead ? `<a href="${compareUrl(repo, repo.default_branch, wt.branch)}" target="_blank" rel="noopener"><span class="badge yellow">▲${wt.ahead}</span></a>` : ''} ${wt.commits_since_default ? `<span class="pill">+${wt.commits_since_default}</span>` : ''}</td>
        <td>${fmt.age(wt.days_since_last_commit)} ago</td>
        <td>${prBadge(wt, repo)}</td>
        <td>${wt.head_short ? (wt.on_remote || wt.deleted ? `<a href="${commitUrl(repo, wt.head)}" target="_blank" rel="noopener">${fmt.esc(wt.head_short)}</a>` : `<span>${fmt.esc(wt.head_short)}</span>`) : ''}</td>
      </tr>`).join('');
    const orphanRows = orphans.map(o => `
      <tr>
        ${branchCell(repo, o.branch, { onRemote: o.on_remote, deleted: !!o.deleted })}
        <td>${o.pr_number ? prBadge(o, repo) : `<span class="badge purple">${o.status === 'merged' ? 'merged' : 'orphan'}</span>`}</td>
        <td colspan="2"><span class="subj">${fmt.esc(o.subject || '')}</span></td>
        <td>${fmt.age(o.days_since_last_commit)} ago</td>
        <td colspan="2">${o.head_short ? (o.on_remote || o.deleted ? `<a href="${commitUrl(repo, o.head)}" target="_blank" rel="noopener">${fmt.esc(o.head_short)}</a>` : `<span>${fmt.esc(o.head_short)}</span>`) : fmt.esc(o.upstream_ref || '')}</td>
      </tr>`).join('');
    const remoteRows = (repo.remote_only || []).map(o => `
      <tr>
        ${branchCell(repo, o.branch, { onRemote: o.on_remote !== false, deleted: !!o.deleted })}
        <td>${o.pr_number ? prBadge(o, repo) : `<span class="badge purple">${o.merged ? 'merged' : 'remote'}</span>`}</td>
        <td colspan="2"><span class="subj">${fmt.esc(o.subject || '')}</span></td>
        <td>${fmt.age(o.days_since_last_commit)} ago</td>
        <td colspan="2">${o.head_short ? (o.on_remote !== false || o.deleted ? `<a href="${commitUrl(repo, o.head)}" target="_blank" rel="noopener">${fmt.esc(o.head_short)}</a>` : `<span>${fmt.esc(o.head_short)}</span>`) : ''}</td>
      </tr>`).join('');
    const prRows = open.map(pr => prRow(pr, repo)).join('');
    return `
      <h2>${fmt.esc(repo.name)} <span class="sub">· ${fmt.esc(repo.root)}</span></h2>
      <table>
        <thead><tr><th>branch</th><th>state</th><th>changes</th><th>vs origin</th><th>age</th><th>PR</th><th>head</th></tr></thead>
        <tbody>${rows || '<tr><td class="empty" colspan="7">no worktrees</td></tr>'}</tbody>
      </table>
      ${open.length ? `
        <h2>Open pull requests</h2>
        <table><thead><tr><th>branch</th><th>state</th><th>title</th><th>diff</th><th>mergeable</th><th>created</th></tr></thead>
        <tbody>${prRows}</tbody></table>` : ''}
      ${remoteOnly.length ? `
        <h2>Remote branches without local worktrees</h2>
        <table><thead><tr><th>branch</th><th>state</th><th>subject</th><th>age</th><th></th></tr></thead>
        <tbody>${remoteRows}</tbody></table>` : ''}
      ${orphans.length ? `
        <h2>Branches without worktrees</h2>
        <table><thead><tr><th>branch</th><th>state</th><th>subject</th><th>age</th><th></th></tr></thead>
        <tbody>${orphanRows}</tbody></table>` : ''}`;
  }).join('');
  document.getElementById('repo-views').innerHTML = views;
  document.getElementById('repocount').textContent = `${(data.repos || []).length} repo${(data.repos || []).length === 1 ? '' : 's'}`;
}

async function refresh() {
  try {
    const r = await fetch('/api/data');
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const data = await r.json();
    render(data);
  } catch (e) {
    document.getElementById('updated').innerHTML = `<span class="dot" style="background:var(--red)"></span>error: ${fmt.esc(e.message)}`;
  }
}

refresh();
setInterval(refresh, 30000);
</script>
</body>
</html>
"""

# ── HTTP ─────────────────────────────────────────────────────────────────

class Handler(BaseHTTPRequestHandler):
    server_version = "cohort-dashboard/1"

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if path == "/healthz":
            self._send(200, b"ok", "text/plain")
            return
        if path == "/api/data":
            try:
                data = _cache.get()
                body = json.dumps(data).encode()
                self._send(200, body)
            except Exception as exc:  # noqa: BLE001 — report, don't crash the server
                self._send(500, json.dumps({"error": str(exc)}).encode())
            return
        if path == "/":
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
            return
        self._send(404, b"not found", "text/plain")

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.log_date_time_string(), fmt % args))


def main():
    port = _load_port_config()
    refresh = DEFAULT_REFRESH
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--port" and i + 1 < len(args):
            port = int(args[i + 1]); i += 2
        elif args[i] == "--refresh" and i + 1 < len(args):
            refresh = int(args[i + 1]); i += 2
        else:
            i += 1
    global _cache
    _cache = DataCache(ttl=refresh)
    srv = ThreadingHTTPServer(("0.0.0.0", port), Handler)
    print(f"cohort dashboard on http://0.0.0.0:{port} (refresh {refresh}s)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
