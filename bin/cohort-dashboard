#!/usr/bin/env python3
"""cohort-dashboard: serve a Cohort worktree/PR dashboard.

    cohort-dashboard [--port 6283] [--refresh 30]

Collects worktree metadata (git) and PR metadata (gh), then serves a small
single-page dashboard. No dependencies beyond Python 3 stdlib.

Endpoints:
    /            the dashboard HTML
    /api/data    fresh JSON (git+gh, cached for --refresh seconds)
    /healthz     "ok"
"""

import json
import os
import re
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

DEFAULT_PORT = 6283
DEFAULT_REFRESH = 30  # seconds between data refreshes

CONFIG_DIR = os.path.join(os.path.expanduser("~"), ".config", "cohort-dashboard")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
PREP = os.path.join(SCRIPT_DIR, "cohort-dashboard-prep")
PR_SCRIPT = os.path.join(SCRIPT_DIR, "cohort-dashboard-pr")


def _load_port_config():
    """Read the configured port from ~/.config/cohort-dashboard/config.

    Only the port is honored. The server serves relative paths that
    resolve against whatever origin the page was loaded from, so a
    configured domain would only send the browser's fetch to a wrong
    origin — never inject one (see dashboard-design.md).
    """
    try:
        if os.path.exists(CONFIG_FILE):
            with open(CONFIG_FILE) as fh:
                fcfg = json.load(fh)
            return int(fcfg.get("port", DEFAULT_PORT))
    except (json.JSONDecodeError, ValueError, OSError):
        pass
    return DEFAULT_PORT


# ── data collection ──────────────────────────────────────────────────────

class DataCache:
    """Thin TTL cache around the collect pipeline.

    gh is slow (network); git is fast. The dashboard refreshes often, so
    cache the combined payload for a few seconds.
    """

    def __init__(self, ttl=DEFAULT_REFRESH):
        self.ttl = ttl
        self._lock = threading.Lock()
        self._data = None
        self._at = 0.0

    def _collect(self):
        proc = subprocess.run([PREP], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              text=True, timeout=120)
        if proc.returncode != 0:
            raise RuntimeError(f"prep failed: {proc.stderr[:500]}")
        data = json.loads(proc.stdout)
        proc = subprocess.run([PR_SCRIPT], input=proc.stdout, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, text=True, timeout=120)
        if proc.returncode != 0:
            # gh failure shouldn't kill the dashboard: fall back to git-only
            data["pr_error"] = proc.stderr[:300]
        else:
            data = json.loads(proc.stdout)
        data["collected_at"] = datetime.now(timezone.utc).isoformat()
        return data

    def get(self):
        now = time.monotonic()
        with self._lock:
            bucket, at = self._data, self._at
            if bucket is not None and now - at < self.ttl:
                return bucket
        data = self._collect()
        with self._lock:
            self._data, self._at = data, now
        return data


_cache = DataCache()

# ── HTML ─────────────────────────────────────────────────────────────────

PAGE = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>cohort dashboard</title>
<style>
