#!/usr/bin/env python3
"""cohort-dashboard-pr: enrich worktree JSON with GitHub PR metadata.

Reads the cohort-dashboard-prep JSON on stdin, adds pr_* fields to every
worktree whose branch has a PR (and collects all open PRs for the repo).

    cohort-dashboard-prep | cohort-dashboard-pr

PR data comes from `gh`, run through `cohort-gh` so multi-host repos target
the right instance. It is network-bound and can be slow or fail; the server
massages the shape, but the collect must never crash on a gh error.
"""

import json
import os
import subprocess
import sys


def run(args, timeout=20, cwd=None):
    try:
        proc = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              text=True, timeout=timeout, cwd=cwd)
        return (proc.returncode, proc.stdout.strip(), proc.stderr.strip())
    except (subprocess.TimeoutExpired, OSError) as exc:
        return (1, "", str(exc))


def gh(cwd, *args):
    """Run gh through cohort-gh (host derived from origin remote).

    cohort-gh derives GH_HOST from `git remote get-url origin` in ITS cwd,
    so we must launch it from the repo root (cwd), not from wherever the
    server happened to be started.
    """
    rc, out, err = run(["cohort-gh", *args], timeout=25, cwd=cwd)
    return (rc, out, err)


def collect_prs(repo):
    """Return {branch: {…pr fields…}, '__open__': [pr, …], '__web__': url} for one repo.

    Also resolves the canonical (public) web URL for the repo — gh knows the
    real GitHub domain, whereas the git remote may point at an internal
    mirror the browser/client can't reach.
    """
    env_guard = os.environ.get("COHORT_NO_GH")
    if env_guard:
        return {}

    root = repo.get("root")
    if not root or not os.path.isdir(root):
        return {}

    result = {}
    # Canonical web URL first: gh returns the public github.com address even
    # when the origin remote uses an internal mirror host.
    rc, out, _ = gh(root, "repo", "view", "--json", "url")
    if rc == 0 and out:
        try:
            url = json.loads(out).get("url", "")
            if url:
                result["__web__"] = url.rstrip("/")
        except json.JSONDecodeError:
            pass

    rc, out, err = gh(root, "pr", "list", "--state", "all", "--limit", "100", "--json",
                      "number,title,state,url,isDraft,headRefName,baseRefName,createdAt,updatedAt,reviewDecision,mergeable,additions,deletions,headRefOid")
    if rc != 0 or not out:
        return result
    try:
        prs = json.loads(out)
    except json.JSONDecodeError:
        return result

    open_prs = []
    for pr in prs:
        head = pr.get("headRefName", "")
        if pr.get("state") == "OPEN":
            open_prs.append(pr)
        if head:
            result[head] = pr
    result["__open__"] = open_prs
    return result


def enrich(entry, pr):
    """Attach pr_* fields to a worktree/orphan/remote-only entry."""
    head = pr.get("headRefOid") or ""
    entry["pr_number"] = pr.get("number")
    entry["pr_state"] = pr.get("state")
    entry["pr_title"] = pr.get("title")
    entry["pr_url"] = pr.get("url")
    entry["pr_draft"] = pr.get("isDraft")
    entry["pr_created_at"] = pr.get("createdAt")
    entry["pr_updated_at"] = pr.get("updatedAt")
    entry["pr_review_decision"] = pr.get("reviewDecision") or ""
    entry["pr_mergeable"] = pr.get("mergeable") or ""
    entry["pr_additions"] = pr.get("additions", 0)
    entry["pr_deletions"] = pr.get("deletions", 0)
    entry["pr_head_sha"] = head[:12]
    entry["pr_head_sha_matches"] = bool(head) and entry.get("head_short") == head[:12]


def main():
    payload = json.load(sys.stdin)
    for repo in payload.get("repos", []):
        prs = collect_prs(repo)
        # Canonical public web URL from gh (see collect_prs): the browser
        # links must point at the real GitHub domain, not an internal
        # mirror host derived from the git remote.
        web = prs.get("__web__")
        if web:
            repo["web"] = web
        for group in (repo.get("worktrees", []),
                      repo.get("orphans", []),
                      repo.get("remote_only", [])):
            for entry in group:
                pr = prs.get(entry.get("branch", ""))
                if pr:
                    enrich(entry, pr)
        repo["open_prs"] = prs.get("__open__", [])
    payload["pr_enriched"] = True
    print(json.dumps(payload))


if __name__ == "__main__":
    main()
