#!/bin/bash
# cohort-update: update the Cohort engine to the latest main.
# Usage: cohort-update
#
# Checks out main and fast-forwards to origin/main. Because worktree-based
# development happens on agent/* branches in separate worktrees, the main
# engine directory should always be on main.
set -e

ENGINE_DIR=$(dirname "$(dirname "$(readlink -f "$0")")")

cd "$ENGINE_DIR"

current_branch=$(git branch --show-current)
if [[ "$current_branch" != "main" ]]; then
    echo "Checking out main (was on $current_branch)..."
    git checkout main
fi

git fetch origin
echo "Fast-forwarding to origin/main..."
if git merge --ff-only origin/main; then
    echo "Updated: $(git log -1 --oneline)"

    # The dashboard unit runs bin/cohort-dashboard from the engine checkout;
    # the running process keeps executing the old script from memory after a
    # fast-forward, so restart the user unit to pick up the new main.
    # Guarded: not every user has the dashboard installed.
    if systemctl --user cat cohort-dashboard.service >/dev/null 2>&1; then
        echo "Restarting cohort-dashboard.service..."
        systemctl --user restart cohort-dashboard.service
        if ! systemctl --user is-active --quiet cohort-dashboard.service; then
            echo "Warning: cohort-dashboard.service failed to restart; check with: systemctl --user status cohort-dashboard" >&2
        fi
    fi
else
    echo "Cannot fast-forward — local main has diverged from origin/main." >&2
    echo "This shouldn't happen if development is done in worktrees." >&2
    echo "Inspect with: git log origin/main..HEAD" >&2
    exit 1
fi
