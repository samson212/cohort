#!/bin/bash
# cohort-update: update the Cohort engine to the latest main.
# Usage: cohort-update
#
# Checks out main and fast-forwards to origin/main. Because worktree-based
# development happens on agent/* branches in separate worktrees, the main
# engine directory should always be on main.
set -e

ENGINE_DIR=$(dirname "$(dirname "$(readlink -f "$0")")")

cd "$ENGINE_DIR"

current_branch=$(git branch --show-current)
if [[ "$current_branch" != "main" ]]; then
    echo "Checking out main (was on $current_branch)..."
    git checkout main
fi

git fetch origin
echo "Fast-forwarding to origin/main..."
if git merge --ff-only origin/main; then
    echo "Updated: $(git log -1 --oneline)"

    # Re-deploy the git wrapper if enforce-git is active (the engine
    # update may have changed bin/git, and ~/.cohort/bin/git is a copy,
    # not a symlink — it must be refreshed).
    ENFORCE_MARKER="$HOME/.cohort/enforce-git"
    if [[ -f "$ENFORCE_MARKER" ]]; then
        WRAPPER_SRC="$ENGINE_DIR/bin/git"
        WRAPPER_DST="$HOME/.cohort/bin/git"
        if [[ -f "$WRAPPER_SRC" ]]; then
            cp "$WRAPPER_SRC" "$WRAPPER_DST"
            chmod +x "$WRAPPER_DST"
            echo "Re-deployed git wrapper: $WRAPPER_DST"
        fi
    fi
else
    echo "Cannot fast-forward — local main has diverged from origin/main." >&2
    echo "This shouldn't happen if development is done in worktrees." >&2
    echo "Inspect with: git log origin/main..HEAD" >&2
    exit 1
fi
