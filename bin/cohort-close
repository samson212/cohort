#!/bin/bash
# cohort-close: clean up a merged branch's worktree and update the primary
# checkout after a PR was merged.
#
# Run from inside the branch's worktree — nothing else is needed:
#   - the worktree being closed is the one the command runs from,
#   - the branch to delete is the one checked out there,
#   - the primary checkout and default branch are derived from git itself.
#
# The flow assumes a HUMAN has already merged the PR on GitHub. The remote
# branch is deliberately NOT deleted here: the merged tip is preserved until
# a human cleans it up in the GitHub UI. Deleting it from a script would also
# require handling authentication, network, and policy failures that are
# better left to a person.
#
# This removes the worktree, deletes the local branch, checks out the default
# branch in the primary checkout, and fast-forwards it to the merged state.
#
# Usage: cohort-close   (no arguments)
set -e

# The worktree to close is the one we're standing in.
WORKTREE=$(git rev-parse --show-toplevel)

# The branch checked out here is the one being closed.
BRANCH=$(git branch --show-current)
if [[ -z "$BRANCH" ]]; then
    echo "Error: detached HEAD in $WORKTREE — nothing to close" >&2
    exit 1
fi

# The primary checkout owns the shared git dir (the parent of .git).
MAIN_ROOT=$(dirname "$(git rev-parse --git-common-dir)")

if [[ "$WORKTREE" == "$MAIN_ROOT" ]]; then
    echo "Error: this is the primary checkout, not a worktree." >&2
    echo "Run cohort-close from the branch's worktree instead." >&2
    exit 1
fi

# All git operations run from the primary checkout, where the metadata lives.
cd "$MAIN_ROOT"

# Resolve the default branch before doing anything destructive, so we can
# fail fast if git state (e.g. a deleted origin/HEAD) is broken.
DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|^refs/remotes/origin/||')
if [[ -z "$DEFAULT_BRANCH" ]]; then
    for candidate in main master; do
        if git show-ref --verify --quiet "refs/remotes/origin/$candidate"; then
            DEFAULT_BRANCH="$candidate"
            break
        fi
    done
fi
if [[ -z "$DEFAULT_BRANCH" ]]; then
    echo "Error: can't determine the default branch." >&2
    echo "Set it with: git remote set-head origin -a" >&2
    exit 1
fi

# Verify the PR was actually merged: the branch tip must be an ancestor of
# the default branch's remote tip. If not, stop -- we must not clean up a
# branch whose work isn't on the default branch yet.
git fetch origin
if git merge-base --is-ancestor "$BRANCH" "origin/$DEFAULT_BRANCH"; then
    echo "$BRANCH is merged into origin/$DEFAULT_BRANCH — proceeding with cleanup."
else
    echo "Error: $BRANCH is not an ancestor of origin/$DEFAULT_BRANCH." >&2
    echo "The PR has not been merged — nothing cleaned up. Merge it first, then rerun." >&2
    exit 1
fi

# 1. Remove the worktree. No --force: a dirty or locked worktree must not be
#    silently discarded. Failure here is fatal — the steps below assume the
#    worktree is gone, and continuing would report success on a cleanup that
#    did not happen.
if ! git worktree remove "$WORKTREE"; then
    echo "Error: could not remove worktree $WORKTREE (dirty or locked)." >&2
    echo "Nothing else was changed. Resolve it, then rerun cohort-close." >&2
    exit 1
fi
echo "Removed worktree: $WORKTREE"

# 2. Delete the now-merged local branch. Fails safely if it's already gone.
git branch -D "$BRANCH" 2>/dev/null || echo "(local branch $BRANCH already gone)"

# 3. Fast-forward the default branch in the primary checkout.
current=$(git branch --show-current)
if [[ "$current" != "$DEFAULT_BRANCH" ]]; then
    git checkout "$DEFAULT_BRANCH"
fi
if git merge --ff-only "origin/$DEFAULT_BRANCH"; then
    echo "$DEFAULT_BRANCH is now at: $(git log -1 --oneline)"
else
    echo "Warning: $DEFAULT_BRANCH could not fast-forward (local history diverged)." >&2
    echo "Inspect with: git log origin/$DEFAULT_BRANCH..HEAD" >&2
    exit 1
fi

# The directory this script was invoked from no longer exists. Callers must
# relocate before running anything else.
echo
echo "NOTE: $WORKTREE no longer exists. Change your working directory to:"
echo "  $MAIN_ROOT"
