#!/usr/bin/env python3
"""
new-conversation hook: auto-load universal Cohort docs into first message.
Resolves Cohort root from its own location (symlink-safe), no tree-walking.
Install: ln -s <repo>/hooks/new-conversation ~/.config/shelley/hooks/new-conversation
"""
import json, sys, os
from pathlib import Path

SELF = Path(os.readlink(__file__) if os.path.islink(__file__) else __file__).resolve()
COHORT_ROOT = SELF.parent.parent  # hooks/new-conversation -> repo root

UNIVERSAL = [
    "docs/git-workflow.md",
    "docs/agent-roles.md",
    "docs/agent-commands.md",
]

def main():
    stdin = sys.stdin.read()
    data = json.loads(stdin) if stdin.strip() else {}
    prompt = data.get("prompt", "")

    if not prompt:
        print(stdin, end="")
        return

    block = (
        f"[Cohort project auto-loaded — universal docs are always in context. "
        f"Project root: {COHORT_ROOT}. "
        f"Do NOT ask to read these files — they are already here.]\n"
    )

    for rel in UNIVERSAL:
        doc = COHORT_ROOT / rel
        if doc.is_file():
            block += f"\n=== {rel} ===\n{doc.read_text().strip()}\n"

    data["prompt"] = block + "\n\n---\n\n" + prompt
    print(json.dumps(data))


if __name__ == "__main__":
    main()
