#!/bin/bash
# slash/cohort-pr: replace /cohort-pr with the full command prompt.
# The hook derives the engine root from its own symlink chain, so it works
# whether symlinked from ~/.config/shelley/hooks/slash/ or run directly.
set -e
SELF=$(readlink -f "$0")
ENGINE_ROOT=$(dirname "$(dirname "$(dirname "$SELF")")")
cat "$ENGINE_ROOT/commands/cohort-pr.md"
# Thread any slash-command arguments through to the prompt.
if [[ -n "${SHELLEY_SLASH_ARGS:-}" ]]; then
    printf '\n$ARGUMENTS: %s\n' "$SHELLEY_SLASH_ARGS"
fi
