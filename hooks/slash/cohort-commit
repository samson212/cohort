#!/bin/bash
# slash/cohort-commit: replace /cohort-commit with the full command prompt.
# The hook derives the engine root from its own symlink chain, so it works
# whether symlinked from ~/.config/shelley/hooks/slash/ or run directly.
set -e
SELF=$(readlink -f "$0")
ENGINE_ROOT=$(dirname "$(dirname "$(dirname "$SELF")")")
cat "$ENGINE_ROOT/commands/cohort-commit.md"
