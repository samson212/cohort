#!/bin/bash
# system-prompt: auto-inject universal Cohort docs into every system prompt.
# Fires on every turn (including subagents), so each agent in a Cohort
# worktree always has universal docs in context.
# Install: ln -s <repo>/hooks/system-prompt ~/.config/shelley/hooks/system-prompt
set -e

SELF=$(readlink -f "$0")
COHORT_ROOT=$(dirname "$(dirname "$SELF")")
prompt=$(cat)

# Idempotency: if the prompt already has the Cohort marker, pass through.
[[ "$prompt" == *"[Cohort project"* ]] && { printf '%s\n' "$prompt"; exit 0; }

NL=$'\n'
AGENT_DIR="$COHORT_ROOT/agents/cohort"

# Build the auto-load reference block (symlinked docs only — no prompt.md).
# TODO(#1): hardcoded "cohort" — should resolve from env or config.
read -r -d '' block <<'BLOCK'
[Cohort project auto-loaded — universal docs are always in context.
 Project root: COHORT_ROOT_PLACEHOLDER.
 Do NOT ask to read these files — they are already here.]
BLOCK
block="${block//COHORT_ROOT_PLACEHOLDER/$COHORT_ROOT}"

# Load symlinked docs alphabetically into the reference block
for entry in "$AGENT_DIR"/*.md; do
    [[ -f "$entry" ]] || continue
    [[ "$(basename "$entry")" == "prompt.md" ]] && continue
    target="$entry"
    if [[ -L "$entry" ]]; then
        target=$(readlink -f "$entry")
    fi
    content=$(< "$target")
    rel="${target#$COHORT_ROOT/}"
    block="${block}${NL}${NL}=== ${rel} ===${NL}${content}"
done

# Warn about dangling symlinks
for entry in "$AGENT_DIR"/*.md; do
    [[ -L "$entry" ]] || continue
    [[ "$(basename "$entry")" == "prompt.md" ]] && continue
    [[ -f "$entry" ]] || echo "hooks/system-prompt: warning: $entry is a dangling symlink (not loaded)" >&2
done

# Load prompt.md separately — it goes at the tail for highest recency.
prompt_md=""
if [[ -f "$AGENT_DIR/prompt.md" ]]; then
    prompt_md=$(< "$AGENT_DIR/prompt.md")
    prompt_md="=== agents/cohort/prompt.md (active rules) ===${NL}${NL}${prompt_md}"
fi

# Reinforce Cohort identity for the main agent (not subagents).
# Subagent prompts contain "subagent" — skip identity override for them.
if [[ "$prompt" != *"subagent"* ]]; then
    prompt="${prompt//You are Shelley/You are Cohort}"
    prompt="${prompt//You are Shelley's subagent/You are Cohort's subagent}"
fi

printf '%s\n\n---\n\n%s\n' "$block" "$prompt"

# Append prompt.md at the tail for main agent only (not subagents).
# Tail position maximizes recency — these rules hit last and hardest.
if [[ "$prompt" != *"subagent"* ]] && [[ -n "$prompt_md" ]]; then
    printf '%s\n' "$prompt_md"
fi
